#!/bin/sh

# ==============================================================================
# 🛑 DEVELOPER SETUP INSTRUCTIONS 🛑
#
# This script automates Firebase project switching and environment variables.
# For this to work on your machine, you must do the following:
#
# 1. Tell your local Git to use this folder by running this command:
#    git config core.hooksPath .githooks
#
# 2. You need the actual API keys to run the app locally.
#    - Ask the team lead for the current keys.
#    - Create two files in the project root: `.env.preview` and `.env.production`
#    - Paste the respective keys into those files.
# ==============================================================================

current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "main" ]; then
    firebase use default > /dev/null 2>&1
    cp .env.production .env.local
elif [ "$current_branch" = "qa" ] || [ "$current_branch" = "staging" ]; then
    firebase use staging > /dev/null 2>&1
    cp .env.preview .env.local
else
    firebase use staging > /dev/null 2>&1
    cp .env.preview .env.local
fi

exit 0