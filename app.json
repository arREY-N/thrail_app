{
  "expo": {
    "owner": "thrail",
    "name": "Thrail App",
    "slug": "thrail_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "thrailapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#2E7D32",
    "assetBundlePatterns": ["**/*"],
    "icon": "./src/assets/logos/Logo Idea 2/Squere Logo.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#2E7D32",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logos/Logo Idea 2/Adaptive Foreground.png",
        "backgroundColor": "#2E7D32"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thesis.thrail",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./public/favicon.png",
      "output": "static"
    },
    "updates": {
      "url": "https://u.expo.dev/b6dba09b-d80c-45d8-ad39-273c63ef2f4e"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logos/Logo Idea 2/Primary Glyph White.png",
          "color": "#2E7D32"
        }
      ],
      [
        "expo-asset",
        {
          "assets": ["src/assets/tiles", "src/assets/fonts"]
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Thrail to track your hike in the background so you never lose your trail.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "@react-native-google-signin/google-signin/app.plugin.js",
      "@react-native-firebase/app/app.plugin.js",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Thrail to access your photos to share in the group chat.",
          "cameraPermission": "Allow Thrail to access your camera to capture photos to share in the group chat."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Thrail to save payment QR codes to your photo gallery.",
          "savePhotosPermission": "Allow Thrail to save payment QR codes to your photo gallery."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logos/Logo Idea 2/Splash Glyph Native.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#2E7D32"
        }
      ],
      "expo-image",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "thrail-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6dba09b-d80c-45d8-ad39-273c63ef2f4e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
