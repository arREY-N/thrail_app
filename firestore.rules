rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /misc/{miscId} {
        allow read: if true;
    }

    match /deployment/{deploymentId} {
        allow read: if true;
    }

    // Login attempt counters (brute-force limiter). Server-only via Admin SDK.
    match /loginAttempts/{attemptId} {
        allow read, write: if false;
    }

    match /leaderboards/{leaderboardId} {
        allow read: if request.auth != null;
        allow create, update, delete: 
            if request.auth != null 
            && request.auth.token.role == 'superadmin';
    }

    match /users/{userId}{
        allow read: if request.auth != null;
      allow create: 
      	if request.auth != null
        && request.auth.uid == userId;
      allow update: 
      	if request.auth != null 
        && (
            (
                request.auth.uid == userId
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            )
            || (
                request.auth.token.role in ['admin', 'superadmin']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneVerifiedAt', 'emergencyContact', 'updatedAt', 'profile'])
                && (
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['emergencyContact'])
                    || (
                        request.resource.data.emergencyContact.get('name', null) == resource.data.emergencyContact.get('name', null)
                        && request.resource.data.emergencyContact.get('contactNumber', null) == resource.data.emergencyContact.get('contactNumber', null)
                        && request.resource.data.emergencyContact.get('relationship', null) == resource.data.emergencyContact.get('relationship', null)
                    )
                )
                && (
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
                    || request.resource.data.updatedAt is timestamp
                )
            )
        );
      allow delete: 
      	if request.auth != null 
        && request.auth.uid == userId;

        match /notifications/{notificationId} {
            allow read, update:
                if request.auth != null 
                && request.auth.uid == userId;
        }

        match /recommendations/{recommendationId} {
            allow read:
                if request.auth != null 
                && (
                    request.auth.uid == userId
                    || request.auth.token.role == 'superadmin'
                );
            allow update:
                if request.auth != null
                && (
                    (
                        request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiReasonings', 'updatedAt'])
                    )
                    || request.auth.token.role == 'superadmin'
                );
            allow create, delete:
                if request.auth != null
                && request.auth.token.role == 'superadmin';
        }
    }

    match /users/{userId}/hikes/{hikeId}/coordinates/{coordinateId} {
        allow read: 
            if request.auth != null;
        allow create, update, delete:   
            if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/hikes/{hikeId}/route/{routeId} {
        allow read: 
            if request.auth != null;
        allow create, update, delete:   
            if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      
      allow create: 
          if request.auth != null;

      allow update: if request.auth != null;

      match /messages/{messageId} {
        allow read, update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participantsIds;

        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participantsIds;
      }

      match /liveLocations/{userId} {
        allow read: if request.auth != null;

        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          (!exists(/databases/$(database)/documents/groups/$(groupId)) ||
           !('participantsIds' in get(/databases/$(database)/documents/groups/$(groupId)).data) ||
           request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participantsIds);

        allow delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /alerts/{alertId} {
        allow read: if request.auth != null;
      }
    }

    match /users/{userId}/hikes/{hikeId}{
        allow read: 
      	    if request.auth != null;
        allow create: 
      	    if request.auth != null
            && request.auth.uid == userId;
        allow update, delete: 
      	    if request.auth != null 
            && request.auth.uid == userId;
    }

    match /applications/{appId}{
        allow read: if request.auth != null;
        allow create:
            if request.auth != null
            && (
                request.auth.uid == request.resource.data.owner.id
                || ('role' in request.auth.token && request.auth.token.role == 'superadmin')
                || (
                    exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin'
                )
            );
        allow update:
            if request.auth != null
            && (
                request.auth.uid == resource.data.owner.id
                || ('role' in request.auth.token && request.auth.token.role == 'superadmin')
                || (
                    exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin'
                )
            );
        allow delete:
            if request.auth != null
            && (
                ('role' in request.auth.token && request.auth.token.role == 'superadmin')
                || (
                    exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin'
                )
            );
    }
    
    match /users/{userId}/recommendations/{recoId}{
        allow read: 
            if request.auth != null 
            && (
                request.auth.uid == userId
                || ('role' in request.auth.token && request.auth.token.role in ['superadmin'])
                || (
                    exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['superadmin']
                )
            );
        
        allow create, update, delete:
            if request.auth != null 
            && (
                ('role' in request.auth.token && request.auth.token.role == 'superadmin')
                || (
                    exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin'
                )
            );
    }
    
    match /payments/{paymentId}{
    	allow read, create: 
            if request.auth != null;
    }
    
    match /users/{userId}/bookings/{bookingId}{
    	allow read:     
      	    if request.auth != null;
        allow create: 
      	    if request.auth != null
            && request.auth.uid == userId;
        allow update, delete: 
      	    if request.auth != null 
            && (
                request.auth.uid == userId 
                || request.auth.token.role in ['admin', 'owner', 'superadmin']
                || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'owner', 'superadmin'])
            );
    }
    
    match /businesses/{businessId} {
    	allow read: if request.auth != null;
        allow create, delete: 
            if request.auth != null 
            && request.auth.token.role == 'superadmin';
        allow update:
            if request.auth != null 
            && (
                    (
                        request.auth.token.role in ['admin', 'owner'] 
                        && 
                        (request.auth.token.businessId == businessId || request.auth.token.owner == businessId)
                        && (
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentConfig'])
                            || (request.auth.token.role == 'owner' || request.auth.token.owner == businessId || request.auth.uid == businessId)
                        )
                    )
                    ||
                    request.auth.token.role == 'superadmin'
            );
    }

    match /{path=**}/cancellations/{cancellationId} {
        allow read, update: 
            if request.auth != null
            && (
                request.auth.token.role in ['admin', 'owner', 'superadmin'] 
                || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'owner', 'superadmin'])
                || request.auth.uid == resource.data.userId
            );
        allow create: 
            if request.auth != null
            && (
                request.auth.uid == request.resource.data.userId 
                || (
                    (
                        request.auth.token.role in ['admin', 'owner', 'superadmin']
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'owner', 'superadmin'])
                    )
                    && (
                        request.auth.token.businessId == request.resource.data.businessId
                        || request.auth.token.owner == request.resource.data.businessId
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == request.resource.data.businessId)
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin')
                    )
                )
            );
        allow delete: 
            if request.auth != null
            && (
                request.auth.uid == resource.data.userId
                || (
                    (
                        request.auth.token.role in ['admin', 'owner', 'superadmin']
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'owner', 'superadmin'])
                    )
                    && (
                        request.auth.token.businessId == resource.data.businessId
                        || request.auth.token.owner == resource.data.businessId
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == resource.data.businessId)
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin')
                    )
                )
            ); 
    }
    
    match /{path=**}/reschedules/{rescheduleId} {
        allow read, update: 
            if request.auth != null
            && (
                request.auth.token.role == 'admin' 
                || request.auth.uid == resource.data.userId
            );
        allow create: 
            if request.auth != null
            && (
                request.auth.uid == request.resource.data.userId 
                || (
                    request.auth.token.role == 'admin'
                    && (
                        request.auth.token.businessId == request.resource.data.businessId
                        || request.auth.token.owner == request.resource.data.businessId
                    )
                )
            );
        allow delete: 
            if request.auth != null
            && (
                request.auth.uid == resource.data.userId
                || (
                    request.auth.token.role == 'admin'
                    && (
                        request.auth.token.businessId == resource.data.businessId
                        || request.auth.token.owner == resource.data.businessId
                    )
                )
            ); 
    }
    
    match /businesses/{businessId}/admins/{adminId} {
    	allow read: if request.auth != null;
        allow create, delete: 
            if request.auth != null 
            && request.auth.token.role == 'superadmin';
        allow update:
            if request.auth != null 
            && (
                    (
                        request.auth.token.role == 'admin' 
                        && 
                        (request.auth.token.businessId == businessId || request.auth.token.owner == businessId)
                    )
                    ||
                    request.auth.token.role == 'superadmin'
            ) 
    }
    
    match /businesses/{businessId}/offers/{offerId} {
    	allow read: if request.auth != null;
        allow create, delete: 
            if request.auth != null 
            && request.auth.token.role == 'admin'
            && (request.auth.token.businessId == businessId || request.auth.token.owner == businessId);
        allow update:
            if request.auth != null 
            && request.auth.token.role == 'admin' 
            && (request.auth.token.businessId == businessId || request.auth.token.owner == businessId)
    }
    
    match /{path=**}/offers/{offerId} {
    	allow read: if request.auth != null;
        allow create, delete: 
            if request.auth != null 
            && request.auth.token.role == 'admin';
        allow update:
            if request.auth != null 
            && request.auth.token.role == 'admin';
    }
    
    match /{path=**}/bookings/{bookingId} {
    	allow read: if request.auth != null;
        allow create, update: 
            if request.auth != null 
            && (
                request.auth.uid == request.resource.data.user.id || 
                request.auth.token.role in ['admin', 'owner', 'superadmin']
            );
    }

    match /mountain/{mountainId} {
    	allow read: if request.auth != null;
      allow create, update, delete: 
      	if request.auth != null
        && request.auth.token.role == 'superadmin';
    }
    
    match /offers/{offerId} {
	    allow read: if request.auth != null;
      
  	  allow create:
    		if request.auth != null
        && 
        (
        	request.auth.token.role == 'superadmin' || 
          (
          	request.auth.token.role == 'admin'
         		&& request.auth.token.businessId == request.resource.data.businessId   
          )
				)
        
      allow update, delete:
    		if request.auth != null
        && 
        (
        	request.auth.token.role == 'superadmin' || 
          (
          	request.auth.token.role == 'admin'
         		&& request.auth.token.businessId == resource.data.businessId   
          )
				)
    }
    
    match /mountains/{mountainId} {
        allow read: if request.auth != null;
        allow create: 
            if request.auth != null 
            && (
                request.auth.token.role == 'superadmin' 
                || request.auth.token.role == 'admin'
            );
        allow update, delete: 
            if request.auth != null 
            && request.auth.token.role == 'superadmin';
    }

    match /province/{provinceId} {
    	allow read: if request.auth != null;
      allow create, update, delete:
      	if request.auth != null
        && request.auth.token.role == 'superadmin'
    }
    
    match /trails/{trailId}{
    	allow read: if request.auth != null;
      allow create, delete:
      	if request.auth != null
        && (
          request.auth.token.role == 'superadmin' 
          || request.auth.token.role == 'admin'
        );
      allow update:
      	if request.auth != null
        && (
          request.auth.token.role == 'superadmin' 
          || request.auth.token.role == 'admin'
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['general', 'updatedAt'])
            && request.resource.data.general.diff(resource.data.general).affectedKeys().hasOnly(['rating', 'reviewCount'])
            && request.resource.data.general.rating is number
            && request.resource.data.general.rating >= 0
            && request.resource.data.general.rating <= 5
            && request.resource.data.general.reviewCount is number
            && request.resource.data.general.reviewCount >= 0
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
              || request.resource.data.updatedAt is timestamp
            )
          )
        );
    }

    match /receipts/{receiptId}{
        allow read, create: if request.auth != null;
    }

    match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow create: 
            if request.auth != null 
            && request.auth.uid == request.resource.data.user.id;
        allow update: 
            if request.auth != null 
            && (
                request.auth.uid == resource.data.user.id 
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'updatedAt'])
                || request.auth.token.role == 'superadmin'
            );
        allow delete:
            if request.auth != null 
            && (
                request.auth.uid == resource.data.user.id 
                || request.auth.token.role == 'superadmin'
            );
    }  
  }
}