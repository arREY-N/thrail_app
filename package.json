{
  "name": "thrail_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "fire": "firebase emulators:start --only functions,auth,firestore,storage --import=./emulator_data --export-on-exit=./emulator_data",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.7",
    "@maplibre/maplibre-react-native": "^11.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^17.4.2",
    "@react-native-firebase/auth": "^17.4.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "^57.0.11",
    "expo-asset": "^57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "^57.0.9",
    "expo-dev-client": "^57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "^57.0.5",
    "expo-location": "~57.0.8",
    "expo-network": "~57.0.1",
    "expo-notifications": "^57.0.9",
    "expo-router": "^57.0.11",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "^57.0.12",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.7.0",
    "firebase-admin": "^12.1.0",
    "immer": "^11.1.4",
    "jest": "~29.7.0",
    "pmtiles": "^4.4.1",
    "puppeteer": "^25.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-chat": "^3.3.2",
    "react-native-image-pan-zoom": "^2.1.12",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "^4.2.2",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.7.4",
    "react-native-zoom-toolkit": "^5.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "jest-expo": "^57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock",
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "postinstall\\.mjs$": "<rootDir>/src/core/test/firebase-postinstall-mock.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|gaxios|uuid|google-auth-library|gcp-metadata|firebase|@?firebase/.*|immer)"
    ]
  }
}
